target/
node_modules/
dist/

# Written by tauri-build on every build: capability schemas for editor
# completion, and one permission file per command. Neither is referenced by
# the hand-written capabilities, so neither belongs in the tree.
src-tauri/gen/schemas/
src-tauri/permissions/autogenerated/

