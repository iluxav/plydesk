{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Trusted desktop permissions. App and embedded content views do not inherit these.",
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "drag:default",
    "core:window:allow-start-dragging",
    "dialog:default",
    "dialog:allow-open",
    "desktop-commands"
  ],
  "webviews": [
    "main"
  ]
}
