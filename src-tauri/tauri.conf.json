{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "plydesk",
  "version": "0.1.6",
  "identifier": "dev.plydesk.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "plydesk",
        "width": 1280,
        "height": 820,
        "maximized": true,
        "dragDropEnabled": true,
        "label": "main",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A desktop for machines you reach over SSH",
    "longDescription": "Files, services, packages, processes and a terminal on any Linux box you can SSH to, with nothing installed on it.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "resources": [
      "../plugins/*/index.js",
      "../plugins/*/manifest.json",
      "../plugins/*/style.css"
    ]
  }
}
